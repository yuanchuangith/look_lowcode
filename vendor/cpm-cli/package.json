{
  "name": "cpm-cli",
  "version": "0.3.1",
  "description": "CPM 低代码平台的 AI 配套 CLI：拉取平台配置物化为本地快照",
  "type": "module",
  "bin": {
    "cpm": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "cpm": "tsx src/cli.ts",
    "prepack": "npm run build",
    "pack:release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
